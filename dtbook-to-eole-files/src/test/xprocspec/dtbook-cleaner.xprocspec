<?xml version="1.0" encoding="UTF-8"?>
<x:description xmlns:x="http://www.daisy.org/ns/xprocspec"
    xmlns:pxi="http://www.daisy.org/ns/pipeline/xproc/internal"
    xmlns:px="http://www.daisy.org/ns/pipeline/xproc"
     xmlns:cx="http://xmlcalabash.com/ns/extensions"
    xmlns:d="http://www.daisy.org/ns/pipeline/data"
    xmlns:c="http://www.w3.org/ns/xproc-step"
    script="../../main/resources/xml/dtbook-cleaner.xpl">

  <x:scenario label="test_dtbook">
    <x:call step="px:dtbook-cleaner.script">
        <x:input  port="source">
            <x:document
                type="file"
                href="../resources/test_dtbook/input/default_sample_for_dtbook_conversion.xml"/>
        </x:input>
        <x:option name="result" select="concat($temp-dir,'test_dtbook/output/')"/>
        <x:option name="temp-dir" select="concat($temp-dir,'test_dtbook/temp/')"/>
        <x:option name="tidy" select="true()" />
        <x:option name="repair" select="true()" />
        <x:option name="narrator" select="false()" />
        <x:option name="ApplySentenceDetection" select="true()" />
    </x:call>
    <x:context label="directory">
        <x:document type="directory" base-uri="temp-dir" href="test_dtbook/output/"/>
    </x:context>
    <x:expect label="expected output files" type="xpath"
              test="count(/*/*[@name='default_sample_for_dtbook_conversion.xml'])=1 and
                    count(/*/*[@name='default_sample_for_dtbook_conversion_NUM_INT.pef'])=1 and
                    count(/*/*[@name='default_sample_for_dtbook_conversion_NUM_ABR.pef'])=1 and
                    count(/*/*[@name='default_sample_for_dtbook_conversion.xhtml'])=1 and
                    count(/*/*[@name='default_sample_for_dtbook_conversion.html'])=1 and
                    count(/*/*[@name='default_sample_for_dtbook_conversion.epub'])=1 and
                    count(/*/*[@name='default_sample_for_dtbook_conversion_daisy202'])=1 and
                    count(/*/*[ends-with(@name,'.jpg') or ends-with(@name,'.png')])=9" equals="true()"/>
    <x:context label="daisy202 directory">
        <x:document type="directory" base-uri="temp-dir" href="test_dtbook/output/default_sample_for_dtbook_conversion_daisy202/"/>
    </x:context>
    <x:expect label="DAISY 2.02 file-set contains ncc.html" type="xpath"
              test="count(/*/*[@name='ncc.html'])=1" equals="true()"/>
    <x:context label="result">
        <x:document type="file" base-uri="temp-dir" href="test_dtbook/output/default_sample_for_dtbook_conversion.xml"/>
    </x:context>
    <x:expect label="result" type="compare">
        <x:document
            type="file"
            href="../resources/test_dtbook/output/default_sample_for_dtbook_conversion.xml"/>
    </x:expect>
    <x:expect label="audio mention present" type="xpath"
              test="count(//*[@id='mentions_audio'])=1 and count(//*[@id='mentions_legales'])=1" equals="true()"/>
    <x:expect label="no dtb-prefixed elements in the result" type="xpath"
              test="count(//*[starts-with(name(),'dtb:')])=0" equals="true()"/>
    <x:context label="pef-int">
        <x:document type="file" base-uri="temp-dir" href="test_dtbook/output/default_sample_for_dtbook_conversion_NUM_INT.pef"/>
    </x:context>
    <x:expect label="NUM_INT pef is a PEF document with content" type="xpath"
              test="local-name(/*)='pef' and count(//*[local-name()='row'])&gt;0" equals="true()"/>
    <x:context label="pef-abr">
        <x:document type="file" base-uri="temp-dir" href="test_dtbook/output/default_sample_for_dtbook_conversion_NUM_ABR.pef"/>
    </x:context>
    <x:expect label="NUM_ABR pef is a PEF document with content" type="xpath"
              test="local-name(/*)='pef' and count(//*[local-name()='row'])&gt;0" equals="true()"/>
    </x:scenario>

</x:description>
